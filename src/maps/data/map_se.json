  "npcs": [
    {
      "id": "garde_razmotek",
      "x": 9,
      "y": 7,
      "name": "Soldat Brennan",
      "firstDialogues": [
        "Halte ! Tu t'approches de l'Antre du Razmotek. Je te déconseille d'aller plus loin sans préparation.",
        "Une créature — un rat d'une taille abominable — creuse dans les sous-sols depuis des semaines.",
        "Il remonte. Lentement, mais sûrement. Ses tunnels fragilisent les fondations du quartier est d'Hélia.",
        "Si on ne l'arrête pas, il va percer les murs de la ville et tout s'effondrera.",
        "Le Professeur Aldren a lancé un appel. Il faut quelqu'un pour descendre là-dedans et en finir.",
        "Si tu veux tenter ta chance, il te faudra une Clef de l'Antre. On dit que les rats mutants en portent parfois."
      ],
      "repeatDialogues": [
        "Le Razmotek creuse toujours. Tu as la Clef de l'Antre ?",
        "Descends là-dedans et mets fin à ça. La ville compte sur toi."
      ]
    }
