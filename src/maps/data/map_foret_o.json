  "npcs": [
    {
      "id": "alchimiste",
      "x": 4,
      "y": 12,
      "name": "Alchimiste",
      "firstDialogues": [
        "Ah, un aventurier... Le Fluide Sauvage a autrefois donné naissance à des armes capables de repousser les créatures mutées.",
        "J'ai retrouvé un ancien réceptacle, mais il lui manque les essences nécessaires à son activation.",
        "Chaque créature mutée concentre une forme particulière de Fluide Sauvage.",
        "Les Sporrins possèdent un fluide végétal, les Défonciers un fluide de rage, les Rumineuses un fluide spirituel et les Groinards un fluide de résistance.",
        "Récupère un échantillon de chacun et rapporte-les moi."
      ],
      "repeatDialogues": [
        "Les essences m'attendent. Reviens quand tu auras récolté les quatre.",
        "Sporrin, Défoncier, Rumineuse, Groinard... Quatre créatures, quatre fluides.",
        "Le réceptacle vibre doucement dans mon laboratoire. Il est prêt à recevoir les essences."
      ]
    },
    {
      "id": "receptacle_fluide",
      "x": 7,
      "y": 12,
      "name": "Réceptacle de Fluide Ancien",
      "firstDialogues": [
        "Le réceptacle vibre faiblement. Quatre emplacements semblent attendre des catalyseurs."
      ],
      "repeatDialogues": [
        "Le réceptacle vibre faiblement. Quatre emplacements semblent attendre des catalyseurs."
      ]
    }
